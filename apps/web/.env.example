# Copia este archivo a apps/web/.env.local y llena los valores. No subas apps/web/.env.local al repositorio.

# Supabase (claves públicas)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_...). Reemplaza a la antigua anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Destino de la redirección de /api en local. En Vercel lo resuelve "Related Projects".
API_URL=http://localhost:8000

# Monitoreo
NEXT_PUBLIC_SENTRY_DSN=
