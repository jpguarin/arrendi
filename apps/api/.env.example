# Copia este archivo a apps/api/.env y llena los valores. No subas apps/api/.env al repositorio.

# local | preview | production
ENVIRONMENT=local

# Base de datos (Supabase)
# API: rol arrendi_api por el agrupador en modo transacción (puerto 6543).
#   postgresql://arrendi_api.<ref>:<clave>@<servidor-del-agrupador>:6543/postgres
DATABASE_URL=
# Tarea diaria: rol arrendi_tasks, mismo formato.
DATABASE_URL_TASKS=
# Alembic: conexión directa (solo IPv6) o agrupador en modo sesión (puerto 5432).
DATABASE_URL_MIGRATIONS=

# Pruebas: PostgreSQL local (Homebrew), con un usuario que pueda crear roles. Nunca Supabase.
TEST_DATABASE_URL=postgresql://localhost:5432/arrendi_test

# Supabase
SUPABASE_URL=
# Clave secreta (sb_secret_...). Reemplaza a la antigua service_role.
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=arrendi

# Correo
EMAIL_API_KEY=
EMAIL_SENDER=
EMAIL_TEST_INBOX=
EMAIL_WEBHOOK_SECRET=

# Tarea diaria
CRON_SECRET=

# Monitoreo
SENTRY_DSN=
