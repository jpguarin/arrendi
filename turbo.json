{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "API_URL",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_RELATED_PROJECTS",
        "VERCEL_ENV"
      ]
    },
    "gen:api": {
      "cache": false
    },
    "web#gen:api": {
      "cache": false,
      "dependsOn": [
        "api#gen:api"
      ]
    },
    "e2e": {
      "cache": false
    }
  }
}
